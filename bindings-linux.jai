**/
xkb_compose_state_get_one_sym :: (state: *xkb_compose_state) -> xkb_keysym_t #foreign libxkbcommon;

#scope_file

#import "Basic"; // For assert

libxkbcommon :: #library,system "libxkbcommon";

#run {
    {
        info := type_info(xkb_rule_names);
        for info.members {
            if it.name == {
                case "rules";
                    assert(it.offset_in_bytes == 0, "xkb_rule_names.rules has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_rule_names.rules has unexpected size % instead of 8", it.type.runtime_size);
                case "model";
                    assert(it.offset_in_bytes == 8, "xkb_rule_names.model has unexpected offset % instead of 8", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_rule_names.model has unexpected size % instead of 8", it.type.runtime_size);
                case "layout";
                    assert(it.offset_in_bytes == 16, "xkb_rule_names.layout has unexpected offset % instead of 16", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_rule_names.layout has unexpected size % instead of 8", it.type.runtime_size);
                case "variant";
                    assert(it.offset_in_bytes == 24, "xkb_rule_names.variant has unexpected offset % instead of 24", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_rule_names.variant has unexpected size % instead of 8", it.type.runtime_size);
                case "options";
                    assert(it.offset_in_bytes == 32, "xkb_rule_names.options has unexpected offset % instead of 32", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_rule_names.options has unexpected size % instead of 8", it.type.runtime_size);
            }
        }
        assert(size_of(xkb_rule_names) == 40, "xkb_rule_names has size % instead of 40", size_of(xkb_rule_names));
    }

    {
        info := type_info(xkb_component_names);
        for info.members {
            if it.name == {
                case "keycodes";
                    assert(it.offset_in_bytes == 0, "xkb_component_names.keycodes has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_component_names.keycodes has unexpected size % instead of 8", it.type.runtime_size);
                case "compatibility";
                    assert(it.offset_in_bytes == 8, "xkb_component_names.compatibility has unexpected offset % instead of 8", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_component_names.compatibility has unexpected size % instead of 8", it.type.runtime_size);
                case "geometry";
                    assert(it.offset_in_bytes == 16, "xkb_component_names.geometry has unexpected offset % instead of 16", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_component_names.geometry has unexpected size % instead of 8", it.type.runtime_size);
                case "symbols";
                    assert(it.offset_in_bytes == 24, "xkb_component_names.symbols has unexpected offset % instead of 24", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_component_names.symbols has unexpected size % instead of 8", it.type.runtime_size);
                case "types";
                    assert(it.offset_in_bytes == 32, "xkb_component_names.types has unexpected offset % instead of 32", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "xkb_component_names.types has unexpected size % instead of 8", it.type.runtime_size);
            }
        }
        assert(size_of(xkb_component_names) == 40, "xkb_component_names has size % instead of 40", size_of(xkb_component_names));
    }
}


