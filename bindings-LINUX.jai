#scope_file


kb_text_shape :: #library,no_dll "vendor/kb_text_shape";

#scope_export
Fixed :: #type,distinct s32;
Fd :: #type,distinct s32;

ProtocolType :: enum {
    INT;
    UINT;
    FIXED;
    OBJECT;
    NEW_ID;
    STRING;
    ARRAY;
    FILE_DESCRIPTOR;
}

Interface_Id :: enum u32 {
    WL_DISPLAY;
    WL_REGISTRY;
    WL_CALLBACK;
    WL_COMPOSITOR;
    WL_SHM_POOL;
    WL_SHM;
    WL_BUFFER;
    WL_DATA_OFFER;
    WL_DATA_SOURCE;
    WL_DATA_DEVICE;
    WL_DATA_DEVICE_MANAGER;
    WL_SHELL;
    WL_SHELL_SURFACE;
    WL_SURFACE;
    WL_SEAT;
    WL_POINTER;
    WL_KEYBOARD;
    WL_TOUCH;
    WL_OUTPUT;
    WL_REGION;
    WL_SUBCOMPOSITOR;
    WL_SUBSURFACE;
    WL_FIXES;
    XDG_WM_BASE;
    XDG_POSITIONER;
    XDG_SURFACE;
    XDG_TOPLEVEL;
    XDG_POPUP;
    ZWP_LINUX_DMABUF_V1;
    ZWP_LINUX_BUFFER_PARAMS_V1;
    ZWP_LINUX_DMABUF_FEEDBACK_V1;
}

Wl_Display_Error :: enum u32 {
    INVALID_OBJECT :: 0;
    INVALID_METHOD :: 1;
    NO_MEMORY :: 2;
    IMPLEMENTATION :: 3;
}

Wl_Display_Request_Sync :: struct {
    OPCODE :: 0;
    ARGS :: ProtocolType.[.NEW_ID];
    callback: u32;
}

Wl_Display_Request_Get_Registry :: struct {
    OPCODE :: 1;
    ARGS :: ProtocolType.[.NEW_ID];
